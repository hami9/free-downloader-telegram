# Telegram Bot Configuration
BOT_TOKEN=your_bot_father_token_here

# Redis Configuration (For task queue & caching)
REDIS_URL=redis://localhost:6379/0

# Optional: Local Telegram Bot API Server URL (Allows sending files up to 2000 MB instead of 50 MB)
# LOCAL_BOT_API_URL=http://localhost:8081

# Worker Configuration
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_DIR=./downloads

# Network / Proxy Configuration (Optional, helps bypass YouTube/Instagram IP rate limits)
# HTTP_PROXY=http://user:pass@proxy_host:port
# COOKIES_FILE=./cookies.txt
